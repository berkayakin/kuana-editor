# The README's demo: scripts/record.sh plays it on this repository (see src/autopilot.rs).

size 1400 875
# The project opens, its tree and Git status read.
wait 4000
mark start
wait 900

# Go to File, then find in it.
action workspace::GoToFile
pace 80
type wrap.rs
wait 600
keys enter
wait 1300
keys secondary-f
type display_row
wait 1300
keys escape
wait 600

# Themes preview live as you pick them; Escape keeps the one before.
action workspace::SelectTheme
type sunset
wait 1400
keys secondary-a
type one light
wait 1400
keys escape
wait 700

# Where the tool buttons go: the activity bar (as it opened), compact,
# then a title bar row of their own, which the Classic layout keeps.
action workspace::ToggleCompactActivityBar
wait 1500
action workspace::ToggleCompactActivityBar
action workspace::ToggleToolsInTitleBar
wait 1700
action workspace::ToggleClassicLayout
wait 1700
action workspace::ToggleClassicLayout
action workspace::ToggleToolsInTitleBar
wait 900

# The Test Explorer: every test in the project, Run and Debug on each row.
action workspace::ShowTestExplorer
wait 2600
keys down
wait 500
keys down
wait 900
action workspace::ToggleResults
wait 600

# The Git log: the commit graph with branches and tags.
action workspace::ToggleGitLog
wait 1300
keys down
wait 700
keys down
wait 1100
action workspace::ToggleGitLog
wait 500

# Markdown with its preview beside it, then Zen mode: just the text.
action workspace::GoToFile
type README.md
wait 600
keys enter
wait 900
action editor::ToggleMarkdownPreview
wait 2200
action workspace::ToggleZenMode
wait 2400
action workspace::ToggleZenMode
wait 1000

mark stop
quit
