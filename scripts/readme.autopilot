# The README's demo: scripts/record.sh plays it on this repository (see src/autopilot.rs).

size 1400 875
# The project opens, its tree and Git status read.
wait 4000
mark start
wait 1000

# Go to File, then find in it.
action workspace::GoToFile
pace 90
type wrap.rs
wait 700
keys enter
wait 1500
keys secondary-f
type display_row
wait 1500
keys escape
wait 800

# Themes preview live as you pick them (Welcome Setup's featured ones);
# Escape keeps the one before.
action workspace::SelectTheme
type sunset
wait 1600
keys secondary-a
type lighthouse night
wait 1600
keys secondary-a
type one light
wait 1600
keys escape
wait 800

# The Classic layout, through Find Action, with a quick look at the
# terminal in it; then back to Modern.
action workspace::FindAction
type classic
wait 700
keys enter
wait 1500
action workspace::ToggleTerminal
# Until the shell is ready, or it echoes the keys early.
wait 1500
type ls
keys enter
wait 1200
action workspace::ToggleTerminal
wait 500
action workspace::FindAction
type classic
wait 500
keys enter
wait 1000

# The Git log: the commit graph with branches and tags.
action workspace::ToggleGitLog
wait 1500
keys down
wait 800
keys down
wait 800
keys down
wait 1400
action workspace::ToggleGitLog
wait 600

# Markdown with its preview beside it.
action workspace::GoToFile
type README.md
wait 700
keys enter
wait 1000
action editor::ToggleMarkdownPreview
wait 3000

mark stop
quit
